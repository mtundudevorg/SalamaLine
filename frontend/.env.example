# Backend API base URL. Setting it switches the app from test mode to the real backend.
#  - Same domain as the frontend (reverse proxy):  /api/v1
#  - Separate domain:  https://api.example.org/api/v1   (backend must allow CORS with credentials)
# Leave this commented out while there is no backend: the app then runs in offline test mode.
# VITE_API_BASE_URL=/api/v1

# Optional: request timeout in milliseconds (default 15000)
# VITE_REQUEST_TIMEOUT_MS=15000

# Optional, development only: proxy /api to your local backend (avoids CORS)
# VITE_DEV_PROXY_TARGET=http://localhost:8000
